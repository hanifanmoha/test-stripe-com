# Copy to .env.local and fill in. .env* is gitignored.
# Use a TEST key (sk_test_...) — this app performs real writes against whatever
# account the key belongs to, including deletes.
# Find it at: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key of the SAME account, for the legacy checkout.js charge flow
# (Charges → New charge). Find it next to the secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
